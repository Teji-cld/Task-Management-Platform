# Copy this file to .env and fill in real values. Never commit .env.
# Real environment variables always win over values in .env.

# --- PostgreSQL (the names match the official postgres Docker image) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tasks
POSTGRES_USER=tasks_user
POSTGRES_PASSWORD=titan

# --- Redis ---
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Leave empty if your Redis has no password.
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=1.0
# How long GET /api/tasks stays cached, in seconds.
CACHE_TTL_SECONDS=60

# --- Application ---
LOG_LEVEL=INFO
# At startup the app retries the database connection this many times.
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY=2.0
